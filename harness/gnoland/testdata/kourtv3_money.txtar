# V3 money core against a real node. The one claim a unit harness cannot make:
# Buy's GNOT really SPLITS — a tenth reaches the keyless burn sink (an address
# derived from a package path carrying a ':', which the path grammar can never
# assign to a deployed realm), nine tenths stay at the realm's own account as the
# court's reserve, the realm's own reads agree with the bank — and Redeem really
# PAYS: coin is destroyed and exactly the quoted pro-rata share arrives back at
# the redeemer, watched at the REDEEMER'S OWN balance and not only at the
# realm's. In-harness, testing.SetOriginSend declares an envelope without
# crediting anyone; here the coins move or fail. Buy's third argument is the
# buyer's floor on units minted (0 here: no floor); the floor's refusal is held
# in-process by TestBuyMinUnitsRefusesAndRefunds.
#
# Also on-chain-checked: CC escrow conservation through OpenClaim/Stake/Unstake,
# zero emission before any verdict (the 20% ceiling starts at literal zero), and
# the §7.4 comms hygiene — the public pages never say backing/APR/redeem.
#
# NOT covered here: answer/dispute/settle timing paths (thousands of blocks);
# those live in realm/r/kourtv3/*_test.gno with SkipHeights.

loadpkg gno.land/p/kourt/checkpoint/v0
loadpkg gno.land/p/kourt/grc20votes/v0
loadpkg gno.land/p/kourt/governor/v0
loadpkg gno.land/p/kourt/twap/v0
loadpkg gno.land/p/kourt/curve/v0
loadpkg gno.land/r/kourt/kourtv3

gnoland start

# Deterministic addresses, cross-checked against the realm's own reads below so
# a typo queries the wrong account and fails loudly.
env COURTV3=g1dkw78ltwhvdl0shgmu9ksw3npuf4ua546mep33
env SINK=g16y57537tw4m2f0wdr6qxug2r73p9q7a5d9ap7j
env USER_ADDR=g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5

# --- Fresh realm: only the review court, hygiene from block one ---------------
# A fresh realm is NOT empty: the meta (appeals) court is deployed at init under
# the reserved slug, so the appeals layer exists before anyone starts a court.
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:"
# THE DIRECTORY ROW, not the bare name. This read 'Review Court' and had been
# red since 6af4c4e renamed the meta court to Meta — a rename that updated the
# realm, the seed and the pages, and left this expectation behind. A bare 'Meta'
# would be the wrong repair: the word is in KOURT:META and in the meta court's
# own description, so the arm would pass on a directory that had stopped listing
# the court at all, which is the one thing it is here to catch.
stdout '\[Meta\]\(/r/kourt/kourtv3:meta\)'
stdout 'principal always returns'
! stdout '[Bb]acking'

# --- Start a court -------------------------------------------------------------
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func StartCourt -args bedford -args 'Bedford Truth Court' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CourtEscrow(\"bedford\")"
stdout ${COURTV3}
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnSink()"
stdout ${SINK}

# Nothing anywhere yet: both accounts empty (a no-coin account returns "").
gnokey query bank/balances/${COURTV3}
stdout 'data: ""'
gnokey query bank/balances/${SINK}
stdout 'data: ""'

# The test clock is never armed on a real deploy, and this file says so before
# any money moves: an armed clock on a chain holding reserve GNOT would let the
# deployer release vote locks and roll emission at will (TWOWAY.md).
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.TestClockFabricated()"
stdout '\(false bool\)'

# --- Buy: real GNOT in, and it SPLITS ------------------------------------------
# 50 GNOT sent. The curve mints CC to the buyer; a tenth (BurnBps 1000) is sent
# to the burn sink in the same call and the rest STAYS at the realm's account as
# this court's reserve. Both halves are read back two ways — the bank, and the
# realm's own ledgered counters — and they must agree to the µGNOT.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args bedford -args 0 -send 50000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout '\([1-9][0-9]* int64\)'
stdout 'OK!'

gnokey query bank/balances/${COURTV3}
stdout 'data: "45000000ugnot"'
gnokey query bank/balances/${SINK}
stdout 'data: "5000000ugnot"'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnedGNOT()"
stdout '\(5000000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.ReserveGNOT(\"bedford\")"
stdout '\(45000000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.TotalReserveGNOT()"
stdout '\(45000000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CourtBurnedGNOT(\"bedford\")"
stdout '\(5000000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnBps()"
stdout '\(1000 int64\)'
# The curve's mint is deterministic: 50 GNOT mints exactly 316227766 CC base
# units, ALL held by the buyer — curve-minted == buyer balance == total supply
# (no other mint path has run; EmittedTotal stays literal zero pre-verdict).
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CurvePosition(\"bedford\")"
stdout '\(316227766 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"$test1_user_addr\")"
stdout '\(316227766 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinSupply(\"bedford\")"
stdout '\(316227766 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.EmittedTotal(\"bedford\")"
stdout '\(0 int64\)'

# A second buy accumulates in both: the sink's share is monotone, the reserve
# grows by the held share. 5 GNOT at this position mints 15,434,713 more units.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args bedford -args 0 -send 5000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query bank/balances/${SINK}
stdout 'data: "5500000ugnot"'
gnokey query bank/balances/${COURTV3}
stdout 'data: "49500000ugnot"'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnedGNOT()"
stdout '\(5500000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CurvePosition(\"bedford\")"
stdout '\(331662479 int64\)'

# --- Redeem: real GNOT OUT, exactly the quoted share ---------------------------
# The quote is floor(reserve × amount / supply) = floor(49,500,000 × 1e8 /
# 331,662,479) = 14,924,811 µGNOT. Redeem must pay exactly that, destroy exactly
# the amount, leave the curve position where it was, leave the sink alone, and
# move both the bank balance and the ledgered reserve by the same figure. No
# -send: Redeem takes no GNOT and refuses any that is attached.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.RedeemValue(\"bedford\",100000000)"
stdout '\(14924811 int64\)'
# THE REDEEMER'S OWN BALANCE, BEFORE AND AFTER. The realm's and the sink's
# balances below prove the GNOT left the reserve; only this pair proves it
# arrived at the redeemer rather than at a third address. The literals are from
# a run of this file — test1's genesis balance less every gas fee and storage
# deposit charged so far — so any change to the transactions above moves them,
# and so does a change to the realm's own source: the package block that every
# Buy rewrites is stored with the realm's declarations, so a new exported
# function moves the first Buy's storage deposit and both literals with it —
# which is why they sit right beside the Redeem. The pair differs by exactly
# 13,924,811 = 14,924,811 paid out − 1,000,000 gas fee: the Redeem itself
# charged no net storage deposit.
gnokey query bank/balances/${USER_ADDR}
stdout 'data: "9999828053200ugnot"'
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Redeem -args bedford -args 100000000 -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout '\(14924811 int64\)'
stdout 'OK!'
gnokey query bank/balances/${USER_ADDR}
stdout 'data: "9999841978011ugnot"'
gnokey query bank/balances/${COURTV3}
stdout 'data: "34575189ugnot"'
gnokey query bank/balances/${SINK}
stdout 'data: "5500000ugnot"'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.ReserveGNOT(\"bedford\")"
stdout '\(34575189 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.TotalReserveGNOT()"
stdout '\(34575189 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.RedeemedGNOT(\"bedford\")"
stdout '\(14924811 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinSupply(\"bedford\")"
stdout '\(231662479 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CurvePosition(\"bedford\")"
stdout '\(331662479 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CourtBurnedGNOT(\"bedford\")"
stdout '\(5500000 int64\)'
# A single base unit returns no whole µGNOT here, and is refused rather than
# burned for nothing; the refusal names the smallest amount that would.
! gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Redeem -args bedford -args 1 -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stderr 'too small to return a µGNOT'
# The meta court is founded one-way: a direct offering burns in full and nothing
# is ever held for it.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args meta -args 0 -send 1000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.ReserveGNOT(\"meta\")"
stdout '\(0 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.RedeemValue(\"meta\",1000000)"
stdout '\(0 int64\)'
gnokey query bank/balances/${SINK}
stdout 'data: "6500000ugnot"'
# And the realm's own balance did not move: a one-way payment leaves nothing at
# the realm, so bedford's reserve is still the whole of what it holds.
gnokey query bank/balances/${COURTV3}
stdout 'data: "34575189ugnot"'

# --- Claim + stake: real CC escrow conservation ---------------------------------
# OpenClaim escrows deposit (1 CC) + fee (0.1 CC) = 1_100_000 base units.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func OpenClaim -args bedford -args 'Is the sky blue?' -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout '\(1 uint64\)'
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${COURTV3}\")"
stdout '\(1100000 int64\)'

# Stake 0.5 CC on YES. Since v0.34 staking is a LOCK IN PLACE, so the escrow does
# NOT grow: the coins stay in the staker's own balance and keep their vote. That is
# the whole point of the change, and this is the only place it is exercised through
# a real transaction on a real ledger rather than in-process.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Stake -args bedford -args 1 -args 0 -args 500000 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${COURTV3}\")"
stdout '\(1100000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.StakePools(\"bedford\",1)"
stdout '500000 int64'

# The position is recorded as a lock against test1's own balance, and locked plus
# spendable partition it. Asserting both halves is what makes this more than a
# restatement of the stake: a lock that recorded nothing would leave spendable
# whole, and a lock that double-counted would leave it short.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.LockedOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(500000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.SpendableOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(230062479 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(230562479 int64\)'

# Unstake it all: the lock clears and the escrow is untouched throughout, because
# the stake was never in it. Conservation, on a real ledger, not a mock.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Unstake -args bedford -args 1 -args 0 -args 500000 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${COURTV3}\")"
stdout '\(1100000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.LockedOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(0 int64\)'

# --- Public pages: the §7.4 hygiene walls ----------------------------------------
# Court and claim pages exist, show absolute CC figures, and never render the
# forbidden framings (backing/redeem/APR/inflation ceiling).
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford"
stdout 'Bedford Truth Court'
! stdout '[Bb]acking'
! stdout 'APR'
! stdout 'redeem'
! stdout '20%'

gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford/1"
stdout 'Is the sky blue\?'
! stdout '[Bb]acking'
! stdout 'APR'

# --- Render security on a REAL node: a hostile claim title -----------------------
# The title carries a markdown link and an HTML/script injection. On-chain
# sanitize.InlineText must neutralize both so qrender's markdown can never emit
# a live link to the attacker's host or a raw <script>/<img> tag — proving the
# escaping holds through the actual qrender path, not just the in-process test.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func OpenClaim -args bedford -args 'INJ[x](http://evil.example)<script>alert(1)</script><img src=q onerror=y>END' -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout '\(2 uint64\)'
stdout 'OK!'

gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford/2"
# The title's safe text still renders (it is shown, not dropped)...
stdout 'INJ'
stdout 'END'
# ...but the dangerous forms are neutralized: InlineText backslash-escapes the
# markdown/HTML-active chars, so no COMPLETE dangerous token can form — no live
# link `](http`, no `<script>` open tag, no img tag that closes with its
# handler (`onerror=y>`). (The bare bytes `<img` still appear as the inert
# `\<img`; the escaped `<` means the HTML renderer never opens a tag.)
! stdout '\]\(http'
! stdout '<script>'
! stdout 'onerror=y>'
# And the claim page still renders its own chrome (the title did not break out
# of its slot and swallow the page).
stdout 'Signal'
stdout 'staked now'

# The hostile title also appears in the court's claim list — same neutralization.
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford"
! stdout '\]\(http'
! stdout '<script>'

# --- Queryability reads a UI depends on (qeval, no md-scraping) -------------------
# One-call human status; settle deadline (0 pre-answer); senior-queue bound;
# per-side pool conviction (0/0 on a fresh claim). All return cleanly.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.ClaimStatus(\"bedford\",2)"
stdout 'open'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.SettleDeadline(\"bedford\",2)"
stdout '\(0 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.QueueLen(\"bedford\")"
stdout '\(0 uint64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.PoolConviction(\"bedford\",2)"
stdout '\(0 int64\)'

# --- The burn share, moved by the deployer, on a real node ------------------------
# The deployer is the DAO admin from AddPackage (init founds the meta court).
# Moving the share is the one governance act that reprices the money path, so
# it is exercised here end to end: the share moves, the NEXT payment splits at
# the new share to the µGNOT — 5 GNOT at 2000 bps burns 1 and holds 4 — and a
# share outside [500, 5000] is refused by the entrypoint with the knob unmoved.
# That last arm is the `elsewhere` for the corpus row that drops the bounds
# call from SetBurnBps: the in-process harness cannot express an authorized
# call that must abort (redeem_test.gno, TestTheBurnShareMovesEveryLaterPayment).
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func SetBurnBps -args 2000 -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnBps()"
stdout '\(2000 int64\)'
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args bedford -args 0 -send 5000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query bank/balances/${SINK}
stdout 'data: "7500000ugnot"'
gnokey query bank/balances/${COURTV3}
stdout 'data: "38575189ugnot"'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.ReserveGNOT(\"bedford\")"
stdout '\(38575189 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CurvePosition(\"bedford\")"
stdout '\(346410161 int64\)'
! gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func SetBurnBps -args 499 -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stderr 'the burn share must be between 500 and 5000 bps'
! gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func SetBurnBps -args 5001 -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stderr 'the burn share must be between 500 and 5000 bps'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnBps()"
stdout '\(2000 int64\)'
