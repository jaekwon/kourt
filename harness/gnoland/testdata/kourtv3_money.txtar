# V2 money core against a real node. The one claim a unit harness cannot make:
# Buy's GNOT really LEAVES — the realm account keeps nothing, the keyless burn
# sink (a never-created sub-realm address) really receives it, and the realm's
# own BurnedGNOT() read agrees with the bank. In-harness, testing.SetOriginSend
# declares an envelope without crediting anyone; here the coins move or fail.
#
# Also on-chain-checked: CC escrow conservation through OpenClaim/Stake/Unstake,
# zero emission before any verdict (the 20% ceiling starts at literal zero), and
# the §7.4 comms hygiene — the public pages never say backing/APR/redeem.
#
# NOT covered here: answer/dispute/settle timing paths (thousands of blocks);
# those live in realm/r/kourtv3/*_test.gno with SkipHeights.

loadpkg gno.land/p/kourt/checkpoint/v0
loadpkg gno.land/p/kourt/grc20votes/v0
loadpkg gno.land/p/kourt/governor/v0
loadpkg gno.land/p/kourt/twap/v0
loadpkg gno.land/p/kourt/curve/v0
loadpkg gno.land/r/kourt/kourtv3

gnoland start

# Deterministic addresses, cross-checked against the realm's own reads below so
# a typo queries the wrong account and fails loudly.
env COURTV3=g1dkw78ltwhvdl0shgmu9ksw3npuf4ua546mep33
env SINK=g16y57537tw4m2f0wdr6qxug2r73p9q7a5d9ap7j
env USER_ADDR=g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5

# --- Fresh realm: only the review court, hygiene from block one ---------------
# A fresh realm is NOT empty: the meta (appeals) court is deployed at init under
# the reserved slug, so the appeals layer exists before anyone starts a court.
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:"
# THE DIRECTORY ROW, not the bare name. This read 'Review Court' and had been
# red since 6af4c4e renamed the meta court to Meta — a rename that updated the
# realm, the seed and the pages, and left this expectation behind. A bare 'Meta'
# would be the wrong repair: the word is in KOURT:META and in the meta court's
# own description, so the arm would pass on a directory that had stopped listing
# the court at all, which is the one thing it is here to catch.
stdout '\[Meta\]\(/r/kourt/kourtv3:meta\)'
stdout 'principal always returns'
! stdout '[Bb]acking'

# --- Start a court -------------------------------------------------------------
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func StartCourt -args bedford -args 'Bedford Truth Court' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CourtEscrow(\"bedford\")"
stdout ${COURTV3}
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnSink()"
stdout ${SINK}

# Nothing anywhere yet: both accounts empty (a no-coin account returns "").
gnokey query bank/balances/${COURTV3}
stdout 'data: ""'
gnokey query bank/balances/${SINK}
stdout 'data: ""'

# --- Buy: real GNOT in, and it does NOT stay -----------------------------------
# 50 GNOT sent. The curve mints CC to the buyer; the spent GNOT is sent to the
# burn sink in the same call. The realm account must end EMPTY — a realm that
# keeps the GNOT is quietly holding a treasury V2 promised not to have.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args bedford -send 50000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout '\([1-9][0-9]* int64\)'
stdout 'OK!'

gnokey query bank/balances/${COURTV3}
stdout 'data: ""'
gnokey query bank/balances/${SINK}
stdout 'data: "50000000ugnot"'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnedGNOT()"
stdout '\(50000000 int64\)'
# The curve's mint is deterministic: 50 GNOT mints exactly 316227766 CC base
# units, ALL held by the buyer — curve-minted == buyer balance == total supply
# (no other mint path has run; EmittedTotal stays literal zero pre-verdict).
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CurvePosition(\"bedford\")"
stdout '\(316227766 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"$test1_user_addr\")"
stdout '\(316227766 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinSupply(\"bedford\")"
stdout '\(316227766 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.EmittedTotal(\"bedford\")"
stdout '\(0 int64\)'

# A second buy accumulates in the sink — one-way, monotone.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args bedford -send 5000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query bank/balances/${SINK}
stdout 'data: "55000000ugnot"'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.BurnedGNOT()"
stdout '\(55000000 int64\)'

# --- Claim + stake: real CC escrow conservation ---------------------------------
# OpenClaim escrows deposit (1 CC) + fee (0.1 CC) = 1_100_000 base units.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func OpenClaim -args bedford -args 'Is the sky blue?' -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout '\(1 uint64\)'
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${COURTV3}\")"
stdout '\(1100000 int64\)'

# Stake 0.5 CC on YES. Since v0.34 staking is a LOCK IN PLACE, so the escrow does
# NOT grow: the coins stay in the staker's own balance and keep their vote. That is
# the whole point of the change, and this is the only place it is exercised through
# a real transaction on a real ledger rather than in-process.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Stake -args bedford -args 1 -args 0 -args 500000 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${COURTV3}\")"
stdout '\(1100000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.StakePools(\"bedford\",1)"
stdout '500000 int64'

# The position is recorded as a lock against test1's own balance, and locked plus
# spendable partition it. Asserting both halves is what makes this more than a
# restatement of the stake: a lock that recorded nothing would leave spendable
# whole, and a lock that double-counted would leave it short.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.LockedOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(500000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.SpendableOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(330062479 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(330562479 int64\)'

# Unstake it all: the lock clears and the escrow is untouched throughout, because
# the stake was never in it. Conservation, on a real ledger, not a mock.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Unstake -args bedford -args 1 -args 0 -args 500000 -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.CoinBalanceOf(\"bedford\",\"${COURTV3}\")"
stdout '\(1100000 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.LockedOf(\"bedford\",\"${USER_ADDR}\")"
stdout '\(0 int64\)'

# --- Public pages: the §7.4 hygiene walls ----------------------------------------
# Court and claim pages exist, show absolute CC figures, and never render the
# forbidden framings (backing/redeem/APR/inflation ceiling).
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford"
stdout 'Bedford Truth Court'
! stdout '[Bb]acking'
! stdout 'APR'
! stdout 'redeem'
! stdout '20%'

gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford/1"
stdout 'Is the sky blue\?'
! stdout '[Bb]acking'
! stdout 'APR'

# --- Render security on a REAL node: a hostile claim title -----------------------
# The title carries a markdown link and an HTML/script injection. On-chain
# sanitize.InlineText must neutralize both so qrender's markdown can never emit
# a live link to the attacker's host or a raw <script>/<img> tag — proving the
# escaping holds through the actual qrender path, not just the in-process test.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func OpenClaim -args bedford -args 'INJ[x](http://evil.example)<script>alert(1)</script><img src=q onerror=y>END' -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout '\(2 uint64\)'
stdout 'OK!'

gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford/2"
# The title's safe text still renders (it is shown, not dropped)...
stdout 'INJ'
stdout 'END'
# ...but the dangerous forms are neutralized: InlineText backslash-escapes the
# markdown/HTML-active chars, so no COMPLETE dangerous token can form — no live
# link `](http`, no `<script>` open tag, no img tag that closes with its
# handler (`onerror=y>`). (The bare bytes `<img` still appear as the inert
# `\<img`; the escaped `<` means the HTML renderer never opens a tag.)
! stdout '\]\(http'
! stdout '<script>'
! stdout 'onerror=y>'
# And the claim page still renders its own chrome (the title did not break out
# of its slot and swallow the page).
stdout 'Signal'
stdout 'staked now'

# The hostile title also appears in the court's claim list — same neutralization.
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv3:bedford"
! stdout '\]\(http'
! stdout '<script>'

# --- Queryability reads a UI depends on (qeval, no md-scraping) -------------------
# One-call human status; settle deadline (0 pre-answer); senior-queue bound;
# per-side pool conviction (0/0 on a fresh claim). All return cleanly.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.ClaimStatus(\"bedford\",2)"
stdout 'open'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.SettleDeadline(\"bedford\",2)"
stdout '\(0 int64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.QueueLen(\"bedford\")"
stdout '\(0 uint64\)'
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv3.PoolConviction(\"bedford\",2)"
stdout '\(0 int64\)'
