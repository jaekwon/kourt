# GENERATED by scripts/scenario.py from scenarios/rewards_demo.py — do not edit.
# Regenerate with: make scenarios
#
# A claim walked to a rewardsOpened draw — with no blocks mined at all.

loadpkg gno.land/p/kourt/checkpoint/v0
loadpkg gno.land/p/kourt/grc20votes/v0
loadpkg gno.land/p/kourt/governor/v0
loadpkg gno.land/p/kourt/twap/v0
loadpkg gno.land/p/kourt/curve/v0
loadpkg gno.land/r/kourt/kourtv3

# Actors. adduser must precede `gnoland start`, so these hoist.
adduser alice 900000000ugnot
adduser bob 900000000ugnot

gnoland start


# --- arm the clock — both halves of it ---------------------------------
gnokey query vm/qeval --data '"gno.land/r/kourt/kourtv3.TestClockActive()"'
stdout 'false'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func EnableTestClockAt -args '1780000000' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'


# --- a court with real coin, and one claim staked ----------------------
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func StartCourt -args 'bedford' -args 'Bedford Truth Court' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args 'bedford' -args '0' -send 400000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Buy -args 'bedford' -args '0' -send 400000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test bob
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func OpenClaim -args 'bedford' -args 'The county certified 12,412 mail ballots on Nov 6, 2025.' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Stake -args 'bedford' -args '1' -args '0' -args '400000000' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'


# --- ripen the trailing average — 2,160 blocks, one transaction --------
# answerWindow, without producing a block
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func AdvanceTestHeight -args '2200' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func Stake -args 'bedford' -args '1' -args '0' -args '1000000' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func PostAnswer -args 'bedford' -args '1' -args '0' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test bob
stdout 'OK!'

gnokey query vm/qeval --data '"gno.land/r/kourt/kourtv3.HasAnswer(\"bedford\",1)"'
stdout 'true'


# --- settle: 72 hours on the calendar half -----------------------------
# just past the settle window
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func AdvanceTestClock -args '259260' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func SettleUndisputed -args 'bedford' -args '1' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey query vm/qeval --data '"gno.land/r/kourt/kourtv3.Settled(\"bedford\",1)"'
stdout 'true'


# --- the participant-only week on OpenRewards --------------------------
# the gate must REFUSE before the advance, or the test proves nothing
! gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func OpenRewards -args 'bedford' -args '1' -gas-fee 1000000ugnot -gas-wanted 200000000 -simulate skip -broadcast -chainid=tendermint_test test1
stderr 'participant-only'

# past finalizeGraceSecs (clock.gno, 7*86400)
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func AdvanceTestClock -args '604860' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv3 -func OpenRewards -args 'bedford' -args '1' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey query vm/qeval --data '"gno.land/r/kourt/kourtv3.RewardsOpened(\"bedford\",1)"'
stdout 'true'
